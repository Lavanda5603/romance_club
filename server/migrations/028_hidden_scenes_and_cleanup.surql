IF record::exists(choice:hidden_ep3_fu_0) AND !record::exists(action:hidden_ep3_fu_0_seen) { CREATE action:hidden_ep3_fu_0_seen CONTENT {choice_id:choice:hidden_ep3_fu_0,type:"changeFlag",title:"Отмечаю прочитанную скрытую сцену",flag_name:"seen_hidden_ep3_fu",flag_value:true}; };
IF record::exists(episode:3) AND !record::exists(scene:hidden_ep3_blog) { CREATE scene:hidden_ep3_blog CONTENT {episode_id:episode:3,background:"ep1/school_yard",character:"alya",character_emotion:"happy",character_position:"center_left",condition:"(friendship_alya>=2) И flag:seen_hidden_ep3_blog!=true",next_scene_id:0,next_scene_key:"scene:hidden_ep3_kagami",order_index:1006,text_position:"center_right",texts:["На перемене Алья показывает мне страницу, которую пока никому не отправляла.", "Алья: «Хочу вести блог о Леди Баг и Супер-Коте. Не слухи, а настоящие истории о том, как они помогают людям».", "Маринетт: «Только не подвергай себя опасности ради кадра. И не выкладывай то, что может выдать чужую тайну».", "Алья кивает: «Обещаю. А ты будешь моим первым читателем?» Я с улыбкой соглашаюсь."],title:"Алья начинает блог",routes:[]}; };
