IF record::exists(episode:3) AND !record::exists(scene:hidden_ep3_chloe) { CREATE scene:hidden_ep3_chloe CONTENT {episode_id:episode:3,background:"ep1/corridor",character:"chloe",character_emotion:"smirk",character_position:"center_left",condition:"(flag:ответила_хлое=false И friendship>=2) И flag:seen_hidden_ep3_chloe!=true",next_scene_id:162,next_scene_key:"scene:162",order_index:1008,text_position:"center_right",texts:["Я уже собираюсь уйти, когда Хлоя неожиданно зовёт меня обратно. На этот раз без насмешки.", "Хлоя: «У тебя всё получается так легко. Друзья, родители, которые тебя слушают… Иногда я тебе завидую».", "Маринетт: «Мне тоже бывает трудно. Но это не повод делать друг другу больно».", "Хлоя отводит взгляд: «Никому не рассказывай, что я это сказала». Я обещаю сохранить разговор между нами. Мы ещё не стали подругами, но я начинаю понимать её лучше."],title:"Признание Хлои",routes:[]}; };
