IF record::exists(episode:4) AND !record::exists(scene:hidden_ep4_luka) { CREATE scene:hidden_ep4_luka CONTENT {episode_id:episode:4,background:"ep1/street_rain",character:"luka",character_emotion:"smile",character_position:"center_left",condition:"(romance_luka>=5 И flag:намекнула_о_секрете=true) И flag:seen_hidden_ep4_luka!=true",next_scene_id:214,next_scene_key:"scene:214",order_index:1009,text_position:"center_right",texts:["Пока команда приходит в себя после битвы, Лука тихо просит меня отойти на несколько шагов.", "Лука: «Когда я возвращал время, я увидел то, чего не должен был видеть. Я знаю, что ты Леди Баг. И знаю, кто Супер-Кот».", "Я замираю. Лука сразу добавляет: «Я не назову его имени. Ваша тайна принадлежит вам. Просто хочу, чтобы ты знала: со мной можно быть собой».", "Маринетт: «Значит, ты понял, о каком секрете я говорила…» Лука кивает и ждёт моего ответа."],title:"Лука доверяет свою тайну",routes:[]}; };
