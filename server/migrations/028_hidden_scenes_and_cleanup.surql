IF record::exists(choice:hidden_ep2_cat_0) AND !record::exists(action:hidden_ep2_cat_0_seen) { CREATE action:hidden_ep2_cat_0_seen CONTENT {choice_id:choice:hidden_ep2_cat_0,type:"changeFlag",title:"Отмечаю прочитанную скрытую сцену",flag_name:"seen_hidden_ep2_cat",flag_value:true}; };
IF record::exists(episode:2) AND !record::exists(scene:hidden_ep2_adrian) { CREATE scene:hidden_ep2_adrian CONTENT {episode_id:episode:2,background:"ep1/roof",character:"adrian",character_emotion:"smile",character_position:"center_left",condition:"(romance_ladybug_adrian>=2 И flag:говорила_с_адрианом_ночью=true) И flag:seen_hidden_ep2_adrian!=true",next_scene_id:114,next_scene_key:"scene:114",order_index:1004,text_position:"center_right",texts:["Когда я собираюсь улетать, Адриан просит меня задержаться ещё на мгновение.", "Адриан: «Я выхожу сюда не только подышать. Иногда надеюсь увидеть тебя над крышами».", "Леди Баг: «Ты ведь не можешь знать, когда я появлюсь».", "Адриан улыбается: «Знаю. Но ждать всё равно хочется». Я обещаю помахать ему, если снова окажусь рядом на патруле."],title:"Адриан ждёт Леди Баг",routes:[]}; };
