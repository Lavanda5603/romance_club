IF record::exists(episode:3) AND !record::exists(scene:hidden_ep3_kagami) { CREATE scene:hidden_ep3_kagami CONTENT {episode_id:episode:3,background:"ep1/corridor",character:"kagami",character_emotion:"surprised",character_position:"center_left",condition:"(friendship_kagami>=2 И flag:дружелюбна_с_кагами=true) И flag:seen_hidden_ep3_kagami!=true",next_scene_id:157,next_scene_key:"scene:157",order_index:1007,text_position:"center_right",texts:["Позже Кагами встречает меня у спортивного зала и предлагает попробовать простое упражнение на равновесие.", "Кагами: «Не нужно быть сильнее всех. Сначала научись спокойно держать стойку».", "Я ошибаюсь, мы пробуем снова, и наконец у меня получается. Кагами впервые смеётся без напряжения.", "Маринетт: «Значит, мы можем тренироваться вместе?» Кагами кивает: «Если ты сама этого хочешь. Без соревнования за чьё-то внимание».", "После короткой тренировки я возвращаюсь в коридор."],title:"Тренировка с Кагами",routes:[]}; };
