IF record::exists(episode:4) AND !record::exists(scene:hidden_ep4_luka_reminder) { CREATE scene:hidden_ep4_luka_reminder CONTENT {episode_id:episode:4,background:"ep1/street_rain",character:"luka",character_emotion:"smile",character_position:"center_left",condition:"",next_scene_id:220,next_scene_key:"scene:220",order_index:1012,text_position:"center_right",texts:["Лука вновь подходит ко мне после ухода Бражника: «Я хотел сказать ещё одно. Всё, о чём мы говорили после битвы, останется между нами».", "Я киваю. Нам больше не нужно повторять признание: его обещание уже дано."],title:"Обещание Луки",routes:[]}; };
IF record::exists(episode:5) AND !record::exists(scene:hidden_self_final) { CREATE scene:hidden_self_final CONTENT {episode_id:episode:5,background:"ep1/street_rain",character:"marinet",character_emotion:"happy",character_position:"center",condition:"",next_scene_id:0,next_scene_key:"",order_index:1013,text_position:"bottom_center",texts:["Бражник побеждён. Впервые за долгое время у меня есть возможность остановиться и послушать собственные мысли.", "Все эти встречи важны для меня. Но я не хочу выбирать кого-то только потому, что боюсь остаться одна.", "Сегодня я выбираю себя: свои мечты, учёбу, друзей и право разобраться в чувствах без спешки.", "Париж постепенно зажигает огни. Впереди ещё столько всего, и я хочу встретить это будущее собой.", "Конец сезона."],title:"Маринетт выбирает себя",routes:[]}; };
IF record::exists(episode:5) AND !record::exists(scene:hidden_team_final) { CREATE scene:hidden_team_final CONTENT {episode_id:episode:5,background:"ep1/street_rain",character:"marinet",character_emotion:"happy",character_position:"center",condition:"",next_scene_id:0,next_scene_key:"",order_index:1014,text_position:"bottom_center",texts:["После победы мы собираемся вместе. Теперь можно говорить не о плане битвы, а о том, что будет завтра.", "Алья первой предлагает не теряться. Нино обещает устроить встречу, Кагами кивает, а Хлоя неожиданно остаётся рядом со всеми.", "Я смотрю на друзей и понимаю: команда держится не только на талисманах. Мы выбирали поддерживать друг друга и тогда, когда никто не видел.", "Что бы ни случилось дальше, мы не останемся одни. Этот вечер принадлежит всем нам.", "Конец сезона."],title:"Команда вместе",routes:[]}; };
-- Меняю только прежние ожидаемые связи; пользовательские перестройки не затираю.
