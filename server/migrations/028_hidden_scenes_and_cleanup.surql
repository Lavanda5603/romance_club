IF record::exists(choice:hidden_ep1_tikki_0) AND !record::exists(action:hidden_ep1_tikki_0_seen) { CREATE action:hidden_ep1_tikki_0_seen CONTENT {choice_id:choice:hidden_ep1_tikki_0,type:"changeFlag",title:"Отмечаю прочитанную скрытую сцену",flag_name:"seen_hidden_ep1_tikki",flag_value:true}; };
IF record::exists(episode:2) AND !record::exists(scene:hidden_ep2_luka) { CREATE scene:hidden_ep2_luka CONTENT {episode_id:episode:2,background:"ep1/party",character:"luka",character_emotion:"calm",character_position:"center_left",condition:"(romance_luka>=3) И flag:seen_hidden_ep2_luka!=true",next_scene_id:71,next_scene_key:"scene:71",order_index:1002,text_position:"center_right",texts:["Когда мы уже собираемся вернуться к остальным, Лука негромко окликает меня.", "Лука: «Подожди. Эта мелодия появилась, пока мы разговаривали. Хочу, чтобы ты услышала её первой».", "Он перебирает струны. Музыка звучит тихо и тепло; в ней будто есть место всем моим несказанным словам.", "Маринетт: «Ты правда только что её придумал?» Лука улыбается: «Иногда достаточно встретить правильного человека».", "Я благодарю его и ещё несколько секунд остаюсь рядом, прежде чем выйти в коридор."],title:"Песня для Маринетт",routes:[]}; };
IF record::exists(scene:hidden_ep2_luka) AND !record::exists(choice:hidden_ep2_luka_0) { CREATE choice:hidden_ep2_luka_0 CONTENT {scene_id:scene:hidden_ep2_luka,text:"Продолжить",title:"Продолжить",order_index:0}; };
IF record::exists(choice:hidden_ep2_luka_0) AND !record::exists(action:hidden_ep2_luka_0) { CREATE action:hidden_ep2_luka_0 CONTENT {choice_id:choice:hidden_ep2_luka_0,type:"nextScene",title:"Продолжаю историю",scene_key:"scene:71",counter_name:"",counter_value:0,flag_name:"secret_scene",flag_value:true}; };
IF record::exists(choice:hidden_ep2_luka_0) AND !record::exists(action:hidden_ep2_luka_0_seen) { CREATE action:hidden_ep2_luka_0_seen CONTENT {choice_id:choice:hidden_ep2_luka_0,type:"changeFlag",title:"Отмечаю прочитанную скрытую сцену",flag_name:"seen_hidden_ep2_luka",flag_value:true}; };
IF record::exists(episode:2) AND !record::exists(scene:hidden_ep2_cat) { CREATE scene:hidden_ep2_cat CONTENT {episode_id:episode:2,background:"ep1/crosswalk",character:"catnoir",character_emotion:"smile",character_position:"center_left",condition:"(romance_cat>=1) И flag:seen_hidden_ep2_cat!=true",next_scene_id:111,next_scene_key:"scene:111",order_index:1003,text_position:"center_right",texts:["У своего дома я слышу знакомый голос с крыши: «Маринетт! Наконец-то нашёл».", "Супер-Кот спускается на тротуар. «После сегодняшнего я хотел убедиться, что ты добралась домой. И, если честно, просто поговорить».", "Маринетт: «Со мной всё хорошо. Спасибо, что искал».", "Мы немного говорим о городе и о том, как странно иногда складывается день. Он не торопится уходить, а я впервые не ищу повод закончить разговор.", "Наконец Супер-Кот возвращается к патрулю. Я поднимаюсь к себе, всё ещё улыбаясь."],title:"Супер-Кот ищет Маринетт",routes:[]}; };
IF record::exists(scene:hidden_ep2_cat) AND !record::exists(choice:hidden_ep2_cat_0) { CREATE choice:hidden_ep2_cat_0 CONTENT {scene_id:scene:hidden_ep2_cat,text:"Продолжить",title:"Продолжить",order_index:0}; };
