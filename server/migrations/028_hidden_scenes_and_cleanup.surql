IF record::exists(episode:4) AND !record::exists(scene:hidden_ep4_adrian) { CREATE scene:hidden_ep4_adrian CONTENT {episode_id:episode:4,background:"ep1/adrian_room_night",character:"adrian",character_emotion:"smile",character_position:"center_left",condition:"(romance_ladybug_adrian>=5) И flag:seen_hidden_ep4_adrian!=true",next_scene_id:250,next_scene_key:"scene:250",order_index:1011,text_position:"center_right",texts:["Я уже отлетаю от окна, когда Адриан всё-таки произносит мне вслед: «Леди Баг, я хотел сказать, что…»", "В комнате раздаётся голос, и он замолкает. Я останавливаюсь над соседней крышей, но возвращаться сейчас нельзя.", "Адриан успевает только помахать мне. Я отвечаю тем же и чувствую, что наш разговор ещё не закончен."],title:"Невысказанное признание Адриана",routes:[]}; };
