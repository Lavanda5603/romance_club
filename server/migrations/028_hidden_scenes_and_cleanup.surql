-- Архивирую только проверенную одиночную сцену без эпизода и входящих ссылок.
DEFINE TABLE IF NOT EXISTS story_archive SCHEMALESS PERMISSIONS NONE;
IF record::exists(scene:339) AND !record::exists(episode:6) AND
    (SELECT VALUE episode_id FROM ONLY scene:339)=episode:6 AND
    (SELECT VALUE title FROM ONLY scene:339)='сцена 1' AND
    array::len(SELECT VALUE id FROM choice WHERE scene_id=scene:339)=0 AND
    array::len(SELECT VALUE id FROM scene WHERE next_scene_key='scene:339' OR next_scene_id IN [339,'scene:339'] OR 'scene:339' IN routes.scene_key)=0 AND
    array::len(SELECT VALUE id FROM action WHERE scene_key='scene:339' OR scene_id IN [339,'scene:339'])=0 AND
    array::len(SELECT VALUE id FROM progress WHERE scene_id='scene:339')=0 AND
    !record::exists(story_archive:orphan_scene_339) {
    CREATE story_archive:orphan_scene_339 CONTENT {reason:'Сцена ссылается на отсутствующий эпизод 6; связей и сохранений нет',source_id:'scene:339',data:(SELECT * FROM ONLY scene:339),archived_at:time::now()};
    DELETE scene:339;
};
-- Добавляю необязательные разговоры. При закрытом условии следующая сцена остаётся доступной.
IF record::exists(episode:1) AND !record::exists(scene:hidden_ep1_alya) { CREATE scene:hidden_ep1_alya CONTENT {episode_id:episode:1,background:"ep1/school_yard",character:"alya",character_emotion:"happy",character_position:"center_left",condition:"(friendship_alya>=2) И flag:seen_hidden_ep1_alya!=true",next_scene_id:30,next_scene_key:"scene:30",order_index:1000,text_position:"center_right",texts:["На перемене Алья замечает, как я всё ещё поглядываю на Адриана, и тихо смеётся.", "Алья: «Можешь не рассказывать всё сразу. Но если тебе понадобится помощь, я рядом. Хлоя больше не будет решать, какой у тебя сегодня день».", "Маринетт: «Спасибо. Мне давно не хватало человека, которому можно просто довериться».", "Мы договариваемся держаться вместе. Кажется, это начало настоящей дружбы."],title:"Настоящие подруги",routes:[]}; };
IF record::exists(scene:hidden_ep1_alya) AND !record::exists(choice:hidden_ep1_alya_0) { CREATE choice:hidden_ep1_alya_0 CONTENT {scene_id:scene:hidden_ep1_alya,text:"Продолжить",title:"Продолжить",order_index:0}; };
IF record::exists(choice:hidden_ep1_alya_0) AND !record::exists(action:hidden_ep1_alya_0) { CREATE action:hidden_ep1_alya_0 CONTENT {choice_id:choice:hidden_ep1_alya_0,type:"nextScene",title:"Продолжаю историю",scene_key:"scene:30",counter_name:"",counter_value:0,flag_name:"secret_scene",flag_value:true}; };
IF record::exists(choice:hidden_ep1_alya_0) AND !record::exists(action:hidden_ep1_alya_0_seen) { CREATE action:hidden_ep1_alya_0_seen CONTENT {choice_id:choice:hidden_ep1_alya_0,type:"changeFlag",title:"Отмечаю прочитанную скрытую сцену",flag_name:"seen_hidden_ep1_alya",flag_value:true}; };
IF record::exists(episode:1) AND !record::exists(scene:hidden_ep1_tikki) { CREATE scene:hidden_ep1_tikki CONTENT {episode_id:episode:1,background:"ep1/corridor",character:"tikki",character_emotion:"smile",character_position:"center_left",condition:"(flag:помог_дедушке=true ИЛИ friendship>=3) И flag:seen_hidden_ep1_tikki!=true",next_scene_id:37,next_scene_key:"scene:37",order_index:1001,text_position:"center_right",texts:["Прежде чем я произношу слова превращения, Тикки просит меня прислушаться.", "Тикки: «Квами связаны с талисманами. Но сила украшения не решает всё за тебя: ты сама выбираешь, кому помочь и как поступить».", "Маринетт: «А если я ошибусь?»", "Тикки: «Тогда попробуешь снова. И ещё: береги свою тайну. Так ты защитишь и себя, и тех, кто тебе дорог».", "Я делаю глубокий вдох. Теперь я лучше понимаю, какую ответственность принимаю."],title:"Тайна талисманов",routes:[]}; };
IF record::exists(scene:hidden_ep1_tikki) AND !record::exists(choice:hidden_ep1_tikki_0) { CREATE choice:hidden_ep1_tikki_0 CONTENT {scene_id:scene:hidden_ep1_tikki,text:"Продолжить",title:"Продолжить",order_index:0}; };
