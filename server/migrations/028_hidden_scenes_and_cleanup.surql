IF record::exists(episode:4) AND !record::exists(scene:hidden_ep4_mask) { CREATE scene:hidden_ep4_mask CONTENT {episode_id:episode:4,background:"ep1/roof",character:"catnoir",character_emotion:"smile",character_position:"center_left",condition:"(romance_ladybug_cat>=5) И flag:seen_hidden_ep4_mask!=true",next_scene_id:230,next_scene_key:"scene:230",order_index:1010,text_position:"center_right",texts:["Супер-Кот вдруг становится непривычно серьёзным и подносит руку к маске.", "Супер-Кот: «Иногда хочется, чтобы ты увидела меня без всего этого. Просто меня».", "Я мягко останавливаю его руку: «Ты мне доверяешь. Но мы оба обещали беречь наши тайны. Не нужно доказывать мне ничего таким способом».", "Он опускает руку и улыбается: «Хорошо, моя леди. Когда-нибудь — если мы оба будем готовы». Его личность остаётся тайной."],title:"Почти снятая маска",routes:[]}; };
