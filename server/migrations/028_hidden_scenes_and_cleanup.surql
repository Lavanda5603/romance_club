IF record::exists(episode:3) AND !record::exists(scene:hidden_ep3_fu) { CREATE scene:hidden_ep3_fu CONTENT {episode_id:episode:3,background:"ep1/roof",character:"fu",character_emotion:"serious",character_position:"center_left",condition:"(flag:помог_дедушке=true И friendship>=3) И flag:seen_hidden_ep3_fu!=true",next_scene_id:117,next_scene_key:"scene:117",order_index:1005,text_position:"center_right",texts:["Перед колледжем я ненадолго заглядываю к мастеру Фу. После последних нападений у меня накопились вопросы.", "Фу: «Ты уже заслужила моё доверие. Твой противник называет себя Бражником. Он использует талисман мотылька и чужие сильные чувства».", "Маринетт: «Вы знаете, кто скрывается под маской?» Фу качает головой: «Нет. Не делай поспешных выводов. Следи за его поступками, а не за обещаниями».", "Я ухожу с новым знанием, но без ответа на главный вопрос. Пора в колледж: сегодня турнир."],title:"Фу рассказывает о Бражнике",routes:[]}; };
IF record::exists(scene:hidden_ep3_fu) AND !record::exists(choice:hidden_ep3_fu_0) { CREATE choice:hidden_ep3_fu_0 CONTENT {scene_id:scene:hidden_ep3_fu,text:"Продолжить",title:"Продолжить",order_index:0}; };
